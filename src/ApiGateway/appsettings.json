{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "candidates": {
        "ClusterId": "candidate",
        "Match": {
          "Path": "/api/candidates/{**catch-all}"
        }
      },
      "companies": {
        "ClusterId": "company",
        "Match": {
          "Path": "/api/companies/{**catch-all}"
        }
      },
      "cvs": {
        "ClusterId": "cv",
        "Match": {
          "Path": "/api/cvs/{**catch-all}"
        }
      },
      "job-descriptions": {
        "ClusterId": "recruitment",
        "Match": {
          "Path": "/api/job-descriptions/{**catch-all}"
        }
      },
      "interviews": {
        "ClusterId": "recruitment",
        "Match": {
          "Path": "/api/interviews/{**catch-all}"
        }
      },
      "matching": {
        "ClusterId": "recruitment",
        "Match": {
          "Path": "/api/matching/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "candidate": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "company": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "cv": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "recruitment": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5005/"
          }
        }
      }
    }
  }
}
